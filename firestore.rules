rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprint: CloudBackupSnapshot
    function isValidCloudBackupSnapshot(data) {
      return data.keys().hasAll([
          'ownerId',
          'ownerEmail',
          'backupLabel',
          'hadithCount',
          'contactCount',
          'templateCount',
          'payload',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'ownerEmail',
          'backupLabel',
          'hadithCount',
          'contactCount',
          'templateCount',
          'payload',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.ownerEmail is string
        && data.ownerEmail.size() >= 3
        && data.ownerEmail.size() <= 200
        && data.backupLabel is string
        && data.backupLabel.size() >= 1
        && data.backupLabel.size() <= 160
        && data.hadithCount is int
        && data.hadithCount >= 0
        && data.hadithCount <= 50000
        && data.contactCount is int
        && data.contactCount >= 0
        && data.contactCount <= 50000
        && data.templateCount is int
        && data.templateCount >= 0
        && data.templateCount <= 1000
        && data.payload is map
        && data.payload.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules: /user_backups/{userId}
    match /user_backups/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId;

      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidCloudBackupSnapshot(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidCloudBackupSnapshot(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'ownerEmail',
            'backupLabel',
            'hadithCount',
            'contactCount',
            'templateCount',
            'payload',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid;
    }
  }
}
